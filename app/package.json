{
  "name": "bone-fracture-detector",
  "version": "1.0.0",
  "description": "YOLOv8 Bone Fracture Detector — on-device ONNX (Capacitor + Electron)",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "postinstall": "node tools/copy_ort_assets.js",
    "serve": "npx serve www -l 8080",
    "electron:start": "electron electron/main.js",
    "electron:build:mac": "npx electron-builder --mac",
    "electron:build:win": "npx electron-builder --win",
    "cap:sync:android": "npx cap sync android",
    "cap:sync:ios": "npx cap sync ios",
    "build:apk": "npm run cap:sync:android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^5.0.0",
    "@capacitor/core": "^5.0.0",
    "@capacitor/ios": "^5.0.0",
    "onnxruntime-web": "^1.20.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "serve": "^14.0.0"
  }
}
